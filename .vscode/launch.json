{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node-terminal",
      "name": "Next.js: dev",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}",
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**",
        "**/.next/**"
      ],
      "sourceMapPathOverrides": {
        "turbopack:///[project]/*": "${workspaceFolder}/*",
        "/turbopack/[project]/*": "${workspaceFolder}/*"
      }
    }
  ]
}
